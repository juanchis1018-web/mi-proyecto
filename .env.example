# Copia este archivo como .env y ajusta los valores. Nunca subas el archivo .env al repositorio.

# Servidor
PORT=3000
NODE_ENV=development
TZ=America/Bogota

# Autenticación: usa una cadena larga y aleatoria en producción
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRA=8h

# Base de datos
# Desarrollo: SQLite (no requiere instalar nada)
DB_DIALECT=sqlite
DB_STORAGE=./datos/corteya.sqlite
# Producción: PostgreSQL. Si DATABASE_URL tiene valor, se usa en lugar de SQLite.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/corteya
# DB_SSL=false

# Cargar datos de demostración si la base de datos está vacía
SEMBRAR_DATOS=true

# Orígenes permitidos para CORS (separados por coma). Vacío = solo el mismo origen.
CORS_ORIGENES=
