{
  "name": "corteya",
  "version": "3.0.0",
  "description": "Plataforma web de gestión de turnos para barberías pyme en Colombia",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "seed": "node backend/src/db/sembrar.js",
    "start:estatico": "node scripts/servidor-estatico.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  },
  "main": "backend/src/server.js",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
